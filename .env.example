# Public client configuration only.
# Copy this file to .env.local and fill in the values from your Supabase project.
# Do not commit .env.local.
# Do not put the service-role key in this app. Alpha does not use it, and a
# NEXT_PUBLIC_ variable would be sent to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only model provider. Do not use a NEXT_PUBLIC_ name.
# GHOST_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# GHOST_AI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
