# Public client configuration only.
# Copy this file to .env.local and fill in the values from your Supabase project.
# Do not commit .env.local.
# The presentation history writer reads SUPABASE_SERVICE_ROLE_KEY on the server.
# Never use a NEXT_PUBLIC_ name for it. Never put it in client code.
# SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only model provider. Do not use a NEXT_PUBLIC_ name.
# Groq is the free default. Ghost never switches to a paid provider on its own;
# OpenAI or Anthropic run only when GHOST_MODEL_PROVIDER names them.
GROQ_API_KEY=
GHOST_MODEL_PROVIDER=
GHOST_AI_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Server-only GitHub read token for repository observations.
# Never use a NEXT_PUBLIC_ name. Never put this in client code, prompts, or evidence excerpts.
# GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_PAT=

# Trusted runner only. The live deployment the runner inspects over https.
# The live server itself never runs inspections.
GHOST_PRODUCTION_URL=

# Opportunity Radar lead workers (Will/Bubba). Off until both env + DB enable.
# BRAVE_SEARCH_API_KEY=
# GHOST_LEAD_WORKERS_ENABLED=0
# GHOST_LEAD_WORKER_SECRET=
# GHOST_LEAD_WORKER_TICK_MS=60000
# GHOST_LEAD_WORKER_DAILY_BRAVE_CAP=24

# Outreach worker. Live sending stays off unless explicitly enabled.
# GHOST_OUTREACH_ENABLED=0
# GHOST_OUTREACH_PROVIDER=fake
# GHOST_OUTREACH_WORKER_SECRET=
# GHOST_OUTREACH_TICK_MS=60000
# Verified SES sandbox inbox you own (never a prospect). Required for SES probe while live is off.
# GHOST_OUTREACH_SES_SANDBOX_TO=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# GHOST_OUTREACH_SES_FROM=
