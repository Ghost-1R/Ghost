# Public client configuration only.
# Copy this file to .env.local and fill in the values from your Supabase project.
# Do not commit .env.local.
# The presentation history writer reads SUPABASE_SERVICE_ROLE_KEY on the server.
# Never use a NEXT_PUBLIC_ name for it. Never put it in client code.
# SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only model provider. Do not use a NEXT_PUBLIC_ name.
# GHOST_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# GHOST_AI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
