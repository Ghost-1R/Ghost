# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example, never commit secrets
.env*
!.env.example

# Accidental host folders. Ghost does not use Vercel.
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local inspector and approval records. These are owner-scoped runtime evidence, not project truth.
.ghost/runtime/
.ghost/presentation/
.ghost/v7-prod-closure.mts
.ghost/v8-prod-closure.mts
.ghost/v8-schema-verify.mts
.ghost/v8-closure-run.mts
.ghost/v9-prod-closure.mts
.ghost/v9-schema-verify.mts
.ghost/v9-closure-run.mts
.ghost/v10-prod-closure.mts
.ghost/v10-schema-verify.mts
.ghost/v10-closure-run.mts
.ghost/v11-prod-closure.mts
.ghost/v11-schema-verify.mts
.ghost/v11-closure-run.mts

# Editor-local settings (not project truth; keeps inspector tree clean).
.cursor/

# Local visual QA artifacts
.ghost/qa/

